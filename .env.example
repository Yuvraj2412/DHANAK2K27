# Supabase Credentials (replace with your Dhanak Supabase project keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Google OAuth Client ID (for "Sign up / Sign in with Google" button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Custom DHANAK Email Sender (Free via Gmail App Password — sends OTP + link branded as DHANAK)
SMTP_USER=your-dhanak-email@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM_NAME=DHANAK 2027 · IIST


# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# IDE / editors
.idea/
.vscode/*
!.vscode/extensions.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep secrets out of git; allow template files)
.env
.env.*
.env*.local
!.env.example
!.env.template

# vercel & supabase local setup / seeds (not needed by Vercel runtime)
.vercel
/supabase/
/supabase_*.sql

# typescript
*.tsbuildinfo
next-env.d.ts

# local backups, scratch & temporary scripts/assets
/scratch/
/scripts/
/image.png
/public/merch/20260928081800-2020-Conscientia.xlsx
*.bak
*.bak.*
*~
/*.py
/*.pdf
/adv_uav_img_*.jpg
/basic_uav_img_*.jpg
/drone_*.jpg
/uav_*.jpg
